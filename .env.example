# 把這個檔案複製成 .env，再依你要用的 AI 服務填寫

# ── AI 翻譯分析服務（擇一）──────────────────────────
# 預設：Claude（品質最穩，建議）
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# OpenAI：
# LLM_PROVIDER=openai
# LLM_API_KEY=你的 OpenAI 金鑰
# LLM_MODEL=你要用的模型名稱

# Google Gemini：
# LLM_PROVIDER=gemini
# LLM_API_KEY=你的 Gemini 金鑰
# LLM_MODEL=你要用的模型名稱

# Ollama（在自己電腦跑開源模型，免金鑰、免費）：
# LLM_PROVIDER=ollama
# LLM_MODEL=模型名稱（用 ollama list 查）

# 其他 OpenAI 相容服務（OpenRouter、DeepSeek、Groq 等）：
# LLM_PROVIDER=custom
# LLM_BASE_URL=服務的 API 網址（例如 https://openrouter.ai/api/v1）
# LLM_API_KEY=你的金鑰
# LLM_MODEL=模型名稱

# ── 其他選填 ──────────────────────────────────────
# whisper 聽寫模型（medium.en 準確、turbo 較快）
WHISPER_MODEL=medium.en
# 工具網址埠號
PORT=5177
